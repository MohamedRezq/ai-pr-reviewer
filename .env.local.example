# =====================================================
# AI PR Reviewer — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# ---- Supabase -------------------------------------------------------
# New key format (sb_publishable_... and sb_secret_...) required.
# Legacy anon/service_role keys still work until end of 2026 but are deprecated.
#
# Get from: Supabase Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # safe for browser, replaces legacy anon key
SUPABASE_SECRET_KEY=sb_secret_...                         # server-only, bypasses RLS — NEVER expose to client

# ---- Anthropic -------------------------------------------------------
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- Stripe ----------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- OpenAI (multi-model consensus) -----------------------------------------
# Get from: https://platform.openai.com/api-keys
# Required for GPT-4.1 model in multi-model consensus + issue embeddings
OPENAI_API_KEY=sk-...

# ---- Google AI (multi-model consensus) ---------------------------------------
# Get from: https://aistudio.google.com/app/apikey
# Required for Gemini 2.0 Flash model in multi-model consensus
GOOGLE_AI_API_KEY=AI...

# ---- GitHub Webhook (auto-review) -------------------------------------------
# A secret you choose when registering GitHub webhooks for auto-review.
# Set the same value in your GitHub repo webhook settings.
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ---- App URL (SEO, OG images, sitemap) --------------------------------------
# Your production domain — no trailing slash
NEXT_PUBLIC_APP_URL=https://getprova.dev

# ---- Sentry (optional) -----------------------------------------------
# Get from: https://sentry.io/
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=ai-pr-reviewer
