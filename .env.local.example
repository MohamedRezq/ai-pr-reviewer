# =====================================================
# AI PR Reviewer — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# ---- Phase 1: Required ----

# Anthropic API Key
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- Phase 1: Optional (Monitoring) ----

# Sentry DSN for error tracking
# Get one at: https://sentry.io/ (free tier available)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=ai-pr-reviewer

# ---- Phase 2: GitHub Integration (add when ready) ----

# NextAuth
# NEXTAUTH_SECRET=generate-with: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Phase 2: Database (add when ready) ----

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  ← NEVER expose to client

# ---- Phase 3: Billing (add when ready) ----

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
